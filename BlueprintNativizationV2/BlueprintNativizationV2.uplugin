{
    "FileVersion": 3,
    "Version": 1,
    "VersionName": "0.4.0",
    "FriendlyName": "BlueprintNativizationV2",
    "Description": "Generates C++ source from supported Blueprint assets, with preview, export and migration tools. Required dependencies: EnhancedInput, ControlRig and Niagara (included with Unreal Engine). SemanticSearch is optional and disabled by default.",
    "Category": "Other",
    "CreatedBy": "AO",
    "CreatedByURL": "https://github.com/SoulofAO",
    "DocsURL": "https://github.com/SoulofAO/BP-To-Cpp-Converter/blob/main/BlueprintNativizationV2/Documentation/UserGuide.md",
    "MarketplaceURL": "com.epicgames.launcher://ue/Fab/product/0cc6dffd-a119-4cad-9753-6d9e6fb5a848",
    "SupportURL": "https://github.com/SoulofAO",
    "EngineVersion": "5.8.0",
    "CanContainContent": false,
    "IsBetaVersion": false,
    "IsExperimentalVersion": false,
    "Installed": false,
    "Modules": [
        {
            "Name": "CppSourceParser",
            "Type": "Editor",
            "LoadingPhase": "Default",
            "PlatformAllowList": [
                "Win64"
            ]
        },
        {
            "Name": "NativeApiCache",
            "Type": "Editor",
            "LoadingPhase": "Default",
            "PlatformAllowList": [
                "Win64"
            ]
        },
        {
            "Name": "BlueprintSourceAnalysis",
            "Type": "Editor",
            "LoadingPhase": "Default",
            "PlatformAllowList": [
                "Win64"
            ]
        },
        {
            "Name": "BlueprintNativizationV2",
            "Type": "Editor",
            "LoadingPhase": "PostEngineInit",
            "PlatformAllowList": [
                "Win64"
            ]
        }
    ],
    "Plugins": [
        {
            "Name": "SemanticSearch",
            "Enabled": false,
            "Optional": true
        },
        {
            "Name": "EnhancedInput",
            "Enabled": true
        },
        {
            "Name": "ControlRig",
            "Enabled": true
        },
        {
            "Name": "Niagara",
            "Enabled": true
        }
    ]
}
